{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boomeyes/ssot/glossary",
  "title": "glossary",
  "type": "object",
  "properties": {
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "replaces": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          }
        },
        "required": ["term", "definition"],
        "additionalProperties": false
      }
    }
  },
  "required": ["terms"],
  "additionalProperties": false
}
