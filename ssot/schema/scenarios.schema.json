{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boomeyes/ssot/scenarios",
  "title": "scenarios",
  "type": "object",
  "properties": {
    "personas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "org": {
            "type": "string"
          },
          "env": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "pain": {
            "type": "string"
          },
          "surfaces": {
            "type": "string"
          }
        },
        "required": ["name", "role", "org", "env", "goal", "pain", "surfaces"],
        "additionalProperties": false
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "prep": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": ["id", "title", "prep"],
        "additionalProperties": false
      }
    },
    "ops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "action_930": {
            "type": ["string", "null"]
          },
          "action_1231": {
            "type": ["string", "null"]
          },
          "screens": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[AB]\\d-\\d{2}M?$"
            }
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": ["string", "null"]
          },
          "tier": {
            "enum": ["core", null]
          }
        },
        "required": ["scenario", "when", "actor", "action_930", "action_1231", "screens", "refs", "note", "tier"],
        "additionalProperties": false
      }
    },
    "narrative": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["title", "paragraphs"],
        "additionalProperties": false
      }
    },
    "demo": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scene": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "surface": {
            "type": "string"
          },
          "screens": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[AB]\\d-\\d{2}M?$"
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          },
          "acc": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ACC-\\d{3}$"
            }
          },
          "track": {
            "enum": ["D1", "D2", "D3", "D4", "D5"]
          },
          "fixture": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": ["scene", "title", "screens", "steps", "track"],
        "additionalProperties": false
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WF-\\d{2}$"
          },
          "title": {
            "type": "string"
          },
          "group": {
            "enum": ["장비 이상", "영상·AI", "사람·현장", "부품", "서류", "운영·계약"]
          },
          "trigger": {
            "type": "object",
            "properties": {
              "by": {
                "enum": ["텔레메트리", "일반 CCTV", "AI 카메라", "바디캠", "사람", "일정", "재고"]
              },
              "what": {
                "type": "string"
              }
            },
            "required": ["by", "what"],
            "additionalProperties": false
          },
          "notify": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "steps": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "actor": {
                  "enum": [
                    "—(시스템)",
                    "건설사(본사)",
                    "건설사(현장)",
                    "건설사(운전자)",
                    "DY(관제)",
                    "DY(운영)",
                    "DY(정비)",
                    "사업주"
                  ]
                },
                "auto": {
                  "type": "boolean"
                },
                "do": {
                  "type": "string"
                },
                "screens": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[AB]\\d-\\d{2}M?$"
                  }
                }
              },
              "required": ["actor", "auto", "do", "screens"],
              "additionalProperties": false
            }
          },
          "today": {
            "type": ["string", "null"]
          },
          "gain": {
            "type": "string"
          },
          "status": {
            "enum": ["demo-ready", "fixture-needed", "proposed"]
          },
          "phase": {
            "enum": [1, 2]
          },
          "screens": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[AB]\\d-\\d{2}M?$"
            }
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scene": {
            "type": "integer"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "group",
          "trigger",
          "notify",
          "steps",
          "today",
          "gain",
          "status",
          "phase",
          "screens",
          "refs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["personas", "scenarios", "ops", "narrative", "demo", "workflows"],
  "additionalProperties": false
}
